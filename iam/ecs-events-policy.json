{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunScheduledTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:ap-east-1:YOUR_ACCOUNT_ID:task-definition/portal-monitor:*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:ap-east-1:YOUR_ACCOUNT_ID:cluster/YOUR_CLUSTER"
        }
      }
    },
    {
      "Sid": "PassTaskRolesOnRunTask",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::YOUR_ACCOUNT_ID:role/portal-monitor-ecs-execution",
        "arn:aws:iam::YOUR_ACCOUNT_ID:role/portal-monitor-ecs-task"
      ]
    }
  ]
}
