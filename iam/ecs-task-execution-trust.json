{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "972910065688"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:ecs:ap-east-1:972910065688:*"
        }
      }
    }
  ]
}
