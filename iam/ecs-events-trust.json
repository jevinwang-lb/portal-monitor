{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventsAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "YOUR_ACCOUNT_ID"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:events:ap-east-1:YOUR_ACCOUNT_ID:rule/portal-monitor-schedule"
        }
      }
    }
  ]
}
