{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-east-1:YOUR_ACCOUNT_ID:secret:portal-monitor/alert-webhook-url*",
        "arn:aws:secretsmanager:ap-east-1:YOUR_ACCOUNT_ID:secret:portal-monitor/dockerhub*"
      ]
    }
  ]
}
