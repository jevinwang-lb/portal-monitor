{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndRegisterTaskDefinition",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyEcsTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::YOUR_ACCOUNT_ID:role/portal-monitor-ecs-execution",
        "arn:aws:iam::YOUR_ACCOUNT_ID:role/portal-monitor-ecs-task"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "UpdateEventBridgeEcsTarget",
      "Effect": "Allow",
      "Action": [
        "events:ListTargetsByRule",
        "events:PutTargets",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:ap-east-1:YOUR_ACCOUNT_ID:rule/portal-monitor-schedule"
    }
  ]
}
